#
# Server
#

PORT=3000

# Named BIND_ADDRESS, not HOSTNAME: the shell and every Docker container
# already export HOSTNAME, and a real environment variable takes
# precedence over this file.
BIND_ADDRESS=0.0.0.0

# Public origin of this instance. Used in canonical URLs, feeds and the
# session cookie's Secure flag (set automatically when this is https).
# No trailing slash.
DOMAIN=http://localhost:3000

# Extra origins allowed to call the API cross-origin, comma-separated, or "*".
# Leave empty (the default) to disable CORS entirely: the creator panel is
# served from this same origin at /panel and needs none. Cross-origin callers
# authenticate with a bearer token. The session cookie is never sent cross-site.
API_ORIGINS=

# How the client IP is determined. One of:
#   direct | cloudflare | aws | gcp | azure | vercel | nginx | development
# Use "cloudflare" when this backend sits behind Cloudflare.
TRUST_PROXY=direct

#
# Database
#

# Uses Bun's native SQL client. Supported drivers, pick one:
#   sqlite://./data/bloggy.sqlite
#   postgres://user:password@localhost:5432/bloggy
#   mysql://user:password@localhost:3306/bloggy
#   mariadb://user:password@localhost:3306/bloggy
DATABASE_URL=sqlite://./data/bloggy.sqlite

# Connection pool size. Ignored by the SQLite driver.
DATABASE_POOL_SIZE=10

#
# Secrets
#

# Generate a fresh set with: bun run keygen

# Encrypts TOTP secrets and backup codes at rest (XChaCha20). Rotating this
# invalidates every enrolled authenticator, so back it up.
ENCRYPTION_KEY=

# Admin token for maintenance endpoints (cache purge, re-render, stats).
ADMIN_TOKEN=

#
# Media storage
#

# local | s3
STORAGE_DRIVER=local

# Used when STORAGE_DRIVER=local
STORAGE_PATH=./data/media

# Used when STORAGE_DRIVER=s3 (Bun's native S3 client: R2, MinIO, B2, AWS)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public base URL media is served from. Leave empty to serve it from this
# backend at DOMAIN/media/*.
CDN_URL=

#
# Site identity
#

# Shown on the platform's own landing page.
SITE_TITLE=Bloggy
SITE_DESCRIPTION=Easy-to-use blogging platform for creators. Write in markdown, publish in seconds.
SITE_AUTHOR=Rabbit Company
SITE_LANGUAGE=en

SITE_WEBSITE=
SITE_DISCORD=
SITE_GITHUB=
SITE_TWITTER=

# Raw HTML injected into <head> of every rendered page (analytics snippet).
SITE_ANALYTICS=

#
# Registration & limits
#

# Set to false to close signups on a private instance.
REGISTRATION_ENABLED=true

# Minimum password entropy in bits (@rabbit-company/password-entropy).
MIN_PASSWORD_ENTROPY=75

# Session lifetime in seconds. Default 30 days.
SESSION_TTL=2592000

# Upload ceilings in bytes, per file.
MAX_AVATAR_SIZE=300000
MAX_IMAGE_SIZE=1000000

# Total stored bytes allowed per account, counting post images and the avatar.
# The ceilings above limit one upload, this limits how many. Set to 0 to allow
# unlimited storage. Default 100 MB.
MAX_ACCOUNT_STORAGE=100000000

#
# Backups
#

# Scheduled snapshots of the database to object storage. SQLite only: on
# Postgres or MySQL use that server's own backup tooling instead.
BACKUP_ENABLED=false

# Seconds between snapshots. 86400 is daily, 21600 is every six hours.
BACKUP_INTERVAL=86400

# How many snapshots to keep. The oldest are deleted after each run.
BACKUP_KEEP=7

# Key prefix inside the bucket.
BACKUP_PREFIX=backups

# A snapshot contains every password hash and email address, so it must not go
# in the media bucket, which is public whenever CDN_URL is set. Use a separate
# private bucket, ideally with credentials that cannot read the media one.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

#
# Cache & observability
#

# Seconds to cache server-rendered pages and public API reads in memory.
CACHE_TTL=300
CACHE_MAX_ENTRIES=1000

# ERROR=0 WARN=1 AUDIT=2 INFO=3 HTTP=4 DEBUG=5 VERBOSE=6 SILLY=7
LOG_LEVEL=3

# Expose OpenMetrics at /metrics. Guarded by ADMIN_TOKEN when set.
METRICS_ENABLED=true

#
# Analytics via BurrowGate (optional)
#

# When Bloggy runs behind a BurrowGate gateway, the Analytics page reads from
# BurrowGate instead of Bloggy's own counter. BurrowGate sees every request,
# including ones served from cache, so the numbers are complete, and it adds
# per-country traffic, referrers and per-path breakdowns.
#
# The page is hidden unless all three of these are set.
#
# Create the token in BurrowGate under API tokens with the "monitoring" scope.
# It starts with bgro_ and is read-only. It is used server-side only and is
# never exposed to the browser.
BURROWGATE_URL=
BURROWGATE_TOKEN=
BURROWGATE_SITE_ID=
